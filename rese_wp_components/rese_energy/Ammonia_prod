results_scenario = scenario.evaluate()

print("Hourly Hydrogen:", scenario.hourly_hydrogen)
print("Hourly Ammonia Production (tons):", scenario.production_hourly_tons)
print("Cumulative Ammonia Production (tons):", scenario.cumulative_production_tonnes)
print("FOPEX:", scenario._fopex())
